# =============================================================================
# LaunchPilot API 환경변수 템플릿 (.env.example)
# =============================================================================

# 1. Database & Knowledge Storage
# DATABASE_URL is the admin (superuser) connection: runs migrations, seeding, and
# auth/scope lookups; it bypasses Row-Level Security.
DATABASE_URL=postgresql://launchpilot:launchpilot-local@127.0.0.1:5432/launchpilot
# APP_DATABASE_URL is the runtime connection as the non-superuser app_user, which is
# what makes tenant RLS actually enforce. Leave unset to keep enforcement inert
# (the app then connects as the superuser and bypasses RLS, same as before).
# Dev role is provisioned by docker/postgres/init-test-db.sql.
# APP_DATABASE_URL=postgresql://app_user:app-user-local@127.0.0.1:5432/launchpilot
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_INDEX=launchpilot-documents-v1
# Required when ELASTICSEARCH_URL is a non-local cluster (fail-closed otherwise).
# ELASTICSEARCH_API_KEY=
# ELASTICSEARCH_CA_CERTS=
# ELASTICSEARCH_VERIFY_CERTS=true

# 2. Google Vertex AI & Gemini Model (ADC 인증 권장)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
EVAL_JUDGE_MODEL=gemini-3.7-flash
EVAL_JUDGE_THINKING_LEVEL=medium
EVAL_JUDGE_LOCATION=global
EVAL_JUDGE_TIMEOUT_SECONDS=60
EVAL_JUDGE_MAX_RETRIES=2
EVAL_JUDGE_MAX_OUTPUT_TOKENS=8192
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_API_KEY=
LLM_MODEL=gemini-2.5-flash

# 3. Observability (OpenTelemetry / Arize Phoenix)
TELEMETRY_ENABLED=false
OTEL_SERVICE_NAME=launchpilot-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:6006/v1/traces

# 4. Server & OAuth Authentication
PUBLIC_BASE_URL=http://127.0.0.1:8000
COOKIE_SECURE=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# 5. Security Secret Keys
APP_SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=

# 6. Ads Platform Integration (Optional)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_API_VERSION=v25
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v24.0
META_PRIMARY_CONVERSION_ACTION=
